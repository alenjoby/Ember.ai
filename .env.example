# Edge function secrets: set with `npx supabase secrets set NAME=value` (never commit real values).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Text AI (moderation, lanterns, Ember replies): Featherless first, Gemini as backup.
FEATHERLESS_API_KEY=
# Optional, defaults to Qwen/Qwen2.5-32B-Instruct
FEATHERLESS_MODEL=
# Gemini: backup for text, and the only provider for voice + drawing checks
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Passcode for the admin double-click on the logo
ADMIN_PASSCODE=
# Comma-separated frontend origins allowed by CORS (localhost:5173 is always allowed).
# "*" matches one host label, e.g. https://ember-*-team.vercel.app
ALLOWED_ORIGINS=
# Optional tuning
TTS_DAILY_LIMIT=200
AI_REPLY_DELAY_MS=20000
# Lanterns fade from the canvas after this many hours (example thoughts never fade)
THOUGHT_TTL_HOURS=24
RATE_SALT=
# Demo video only: simulated peer replies + dummy online count. Turn OFF before submitting.
DEMO_MODE=false
DEMO_ONLINE=8
# Demo autopilot: a simulated thought every N seconds while the app is open (max DEMO_MAX_THOUGHTS)
DEMO_POST_EVERY_SEC=30
DEMO_MAX_THOUGHTS=40
