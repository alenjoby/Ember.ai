# Edge function secrets: set with `npx supabase secrets set NAME=value` (never commit real values).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Passcode for the admin double-click on the logo
ADMIN_PASSCODE=
# Comma-separated frontend origins allowed by CORS (localhost:5173 is always allowed).
# "*" matches one host label, e.g. https://ember-*-team.vercel.app
ALLOWED_ORIGINS=
# Optional tuning
TTS_DAILY_LIMIT=200
AI_REPLY_DELAY_MS=20000
RATE_SALT=
# Optional (Oct 8): Featherless
FEATHERLESS_API_KEY=
LLM_PROVIDER=gemini
